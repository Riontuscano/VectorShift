# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ─── Backend ───────────────────────────────────────────────────────────────

# MongoDB connection string. Optional: if unreachable, the backend logs a
# warning and falls back to an in-memory store that is wiped on restart.
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=mongodb://localhost:27017/

# Groq API key. Required only by the LLM node; every other node works without it.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Browser origins allowed to call the API, comma-separated.
# Leave as "*" for local development. In production set it to your frontend URL:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# "development" enables uvicorn auto-reload. Use "production" when deployed.
ENVIRONMENT=development

# Port the backend binds to. Hosting platforms override this automatically.
PORT=8000
