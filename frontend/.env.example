# Copy to `.env.local` for local development, or set in the Vercel dashboard
# under Settings -> Environment Variables for deployments.
#
# Create React App only exposes variables prefixed with REACT_APP_, and inlines
# them at BUILD time — changing this requires a rebuild/redeploy, not a restart.

# Base URL of the FastAPI backend, with no trailing slash.
# Local:  http://localhost:8000
# Render: https://vectorshift-backend.onrender.com
REACT_APP_API_URL=http://localhost:8000
